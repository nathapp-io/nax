/**
 * Temporary test for logger spy.
 */
import { describe, expect, test, spyOn } from "bun:test";
import { getSafeLogger, initLogger, resetLogger } from "@/logger";

describe("logger spy debug", () => {
  test("warn is captured by spy", async () => {
    resetLogger();
    const logger = initLogger({ level: "silent" });
    const spy = spyOn(logger, "warn");
    getSafeLogger()?.warn("rate-card", "test message", { foo: "bar" });
    console.log("warn calls:", spy.mock.calls.length);
    console.log("calls:", JSON.stringify(spy.mock.calls));
    expect(spy.mock.calls).toHaveLength(1);
  });
});