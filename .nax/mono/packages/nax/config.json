{
  "quality": {
    "commands": {
      "test": "bun run --cwd ../nax-ai build && bun run test",
      "typecheck": [
        "bun run --cwd ../nax-ai build",
        "bun check",
        "bun check -p tsconfig.test.json"
      ],
      "lint": [
        "AGENT=1 bun run lint:biome",
        "AGENT=1 bun run check:all-without-biome"
      ],
      "coverage": "bun run test:coverage",
      "build": "bun run build",
      "testScoped": "CI=1 AGENT=1 bun test --timeout=60000 {{files}}",
      "lintFix": "bun run lint:fix",
      "formatFix": "bun run lint:fix"
    }
  }
}
