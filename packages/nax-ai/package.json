{
  "name": "@nathapp/nax-ai",
  "version": "0.1.1",
  "description": "Provider-agnostic LLM client: completions, streaming, tool calls, usage and auth across API-key and OAuth providers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "bun scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "check:no-bun-apis": "bun run scripts/check-no-bun-apis.ts",
    "check:pi-ai-imports": "bun run scripts/check-pi-ai-imports.ts",
    "lint": "bun x biome check --error-on-warnings src/ test/ scripts/ && bun run check:no-bun-apis && bun run check:pi-ai-imports",
    "lint:fix": "bun x biome check --write src/ test/ scripts/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "keywords": [
    "llm",
    "ai",
    "anthropic",
    "openai",
    "provider",
    "streaming"
  ],
  "license": "MIT",
  "author": "William Khoo",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathapp-io/nax-ai.git"
  },
  "homepage": "https://github.com/nathapp-io/nax-ai",
  "bugs": {
    "url": "https://github.com/nathapp-io/nax-ai/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true,
    "tag": "latest"
  }
}
