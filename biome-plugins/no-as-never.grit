language js

// `as never` — the bottom type is assignable to EVERY other type, so this
// silences any assignment error in one word. It is a strictly stronger escape
// hatch than `as any`, and biome ships no built-in rule for it.
//
// Scoped to `test/**` in biome.json. src/ still has 2 sites
// (src/interaction/plugins/webhook-serve-compat.ts — `this`-argument casts on
// `.call()`); widening the scope means draining those first.
//
// This replaces the `asNever` counter in scripts/check-test-escape-hatches.ts
// as the MEASURE. That counter is text and stays as a secondary guard for the
// residue a parser cannot see (prose), exactly as `asAny` and `nonNullAssert`
// did when their biome rules were promoted — see the script's doc comment.
`$expr as never` where {
  register_diagnostic(
    span = $expr,
    message = "`as never` silences every assignment error. Complete the fixture, tighten the helper's return type, or narrow the parameter — see .nax/rules/test-ratchets.md."
  )
}
