#!/usr/bin/env bash
# nax pre-commit hook — runs typecheck + lint
# Install: git config core.hooksPath .githooks

set -e

# Ensure bun is on PATH (git hooks run with minimal PATH)
export PATH="$HOME/.bun/bin:$PATH"

echo "[pre-commit] Running typecheck..."
bun run typecheck

# `check:all` runs lint plus every static gate. Listing gates individually here
# is what let earlier ones ship unwired — a new gate added to package.json is
# picked up automatically, and check:gate-reachability fails if one is orphaned.
echo "[pre-commit] Running all static checks..."
bun run check:all

echo "[pre-commit] OK"
